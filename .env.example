# Copy to .env.local for local development. On Vercel, set the same keys in
# Project → Settings → Environment Variables (all of them, including at
# build time — prerendered pages query the database during `next build`).

# --- Neon Postgres (branch: production) ---
DATABASE_URL=
# Pooled/unpooled variants pulled from `neon env pull`; optional for the app.
DATABASE_URL_UNPOOLED=

# --- Neon Auth ---
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# --- Avatar uploads (S3-compatible object storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=
AWS_S3_BUCKET=avatars
